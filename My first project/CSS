:root {
    --gray: #212121;
    --green: #009660;
    --white: #e9e9e9;
    --black: #0c0c0c;
    --lgray: #929292;
}
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    color: var(--white);
}
html, body {
    background-color: var(--black);
    width: 100%;
    height: 100%;
}
body {
    background-color: #000;
    font-family: Arial, Helvetica, sans-serif;
}
.green{
    color: var(--green);
}
.lgray{
    color: var(--lgray);
}
/* ================= NAV ================= */
nav {
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 100; /* Fixed: Removed 'px' unit */
    width: 100%;
    height: 80px;
    padding: 0 5vw;
    position: fixed;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 1000;
}
.nav1 img {
    width: 220px;
    cursor: pointer;
}
.nav2 {
    display: flex;
    align-items: center;
    gap: 2vw;
}
.nav2 h4,
.nav3 h4 {
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.3s ease;
}
.nav2 h4:hover,
.nav3 h4:hover {
    color: #00A6FF;
}
.nav2 h5,
.nav3 h5 {
    display: none;
    font-size: 30px;
    cursor: pointer;
}
.nav3 {
    display: none;
    align-items: center;
    gap: 2vw;
}
/* ================= MAIN CONTENT ================= */
main {
    padding-top: 100px;
}
.section1 {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 15px 70px;
    font-family: Helvetica, Arial, sans-serif;
}
.section1 .left {
    width: 42%;
}
.section1 .left h1 {
    font-size: 48px;
}
.section1 .left .tags {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    margin: 30px 0;
}
.section1 .left .tags h4 {
    padding: 10px 20px;
    border-radius: 4px;
    white-space: nowrap;
    background-color: var(--gray);
}
.left .price {
    font-size: 35px;
}

.left .price .lgray {
    font-size: 20px;
    font-weight: 800;
}
.section1 .left .cta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0;
}
.cta button {
    background: var(--green);
    padding: 20px 60px;
    border-radius: 5px;
    border: none;
    font-size: 20px;
    cursor: pointer;
}
.cta button:nth-child(2) {
    background-color: var(--gray);
}
.section1 .right {
    width: 50%;
}
.section1 .right .right-in {
    width: 100%;  
    max-width: 600px;
    border-radius: 5px;
    overflow: hidden;
}
.section1 .right .right-in .image {    
    width: 100%;
    height: 350px;
}
.section1 .right .right-in .image img {    
    width: 100%; 
    height: 100%;
    object-fit: cover;
}
.section1 .right .right-in .image-bottom {    
    padding: 20px;
    background-color: var(--gray);
    padding-top: 40px;
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
}
.right-in .image-bottom h4 {
    background-color: #151515;
    padding: 10px 15px;
    border-radius: 5px;
    width: 45%;
}
/* ================= MEDIA QUERIES ================= */

@media (max-width: 1400px) {
    .section1 .left h1 {
        font-size: 3.5vw;
    }
}
@media (max-width: 900px) {
    .nav1 img {
        width: 180px;
    }

    .nav2 {
        gap: 20px;
    }

    .nav2 h4 {
        font-size: 15px;
    }
}
@media (max-width: 800px) {
    main {
        width: 100%; /* Fixed: Changed from 50px */
    }

    .section1 {
        flex-direction: column-reverse;
        padding: 15px 5vw;
    }
    .section1 .left {
        width: 100%;
        margin-top: 30px;
    } 
    .section1 .left h1 {
        font-size: 33px;
    }
    .section1 .right {
        width: 100%;
    }

    .section1 .right .right-in {
        width: 100%;
    }
    .section1 .right .right-in .image {    
        width: 100%;
        height: 50vw;
    }

    .section1 .right .right-in .image-bottom {    
        padding: 10px;
        padding-top: 20px;
        gap: 8px;
    }
    .right-in .image-bottom h4 {
        padding: 9px 12px;
        border-radius: 5px;
        font-size: 2.5vw;
        width: 45%;
    }

    .left .price {
        font-size: 5vw;
    }

    .left .price .lgray {
        font-size: 3vw;
        font-weight: 800;
    }
    .section1 .left .cta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin: 20px 0;
    }
    .cta button {
        background: var(--green);
        padding: 15px 0;
        width: 50%;
        border-radius: 5px;
        border: none;
        font-size: 20px;
    }
}

@media (max-width: 600px) {
    nav {
        height: 70px;
        padding: 13px 20px;
    }

    .nav1 img {
        width: 170px;
        height: 30px;
    }

    .nav1 h4 {
        font-size: 12px;
    }
    .nav2 {
        display: none;
    }

    .nav3 {
        display: flex;
    }

    .section1 .left h1 {
        font-size: 5vw;
    }
}
